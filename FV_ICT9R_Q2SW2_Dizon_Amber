<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>OBMC Contact Us</title>

    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: white;
        }

        

        .navbar {
            background-color: #212529;
            height: 76px;
            margin: 7px 18px 0 18px;
            padding: 8px 16px;
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            color: white !important;
            font-size: 15px;
            font-weight: normal;
            text-decoration: none;
        }

        

        .school-logo {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            object-fit: cover;
        }

        

        .search-box {
            width: 188px;
            height: 38px;
            font-size: 14px;
        }

        .search-button {
            height: 38px;
            background-color: #087ff5;
            border-color: #087ff5;
            font-size: 14px;
        }

        .search-button:hover {
            background-color: #006bd6;
        }

        

        .background {
            position: relative;
            margin: 0 18px 16px 18px;
            min-height: 649px;
            padding-top: 49px;
            overflow: hidden;
        }

        

        .background::before {
            content: "";
            position: absolute;
            top: -8px;
            left: -8px;
            right: -8px;
            bottom: -8px;

            <background-image: url("https://obmontessori.orangeapps.ph/landing/obmontessori/images/Las%20Pinas%20Facade.jpg");>

            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;

            filter: blur(3px);
            z-index: 0;
        }

        

        .content {
            position: relative;
            z-index: 1;

            width: 1310px;
            max-width: 100%;

            margin: auto;

            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 30px;
        }

        

        .office-section {
            width: 641px;
            flex-shrink: 1;
        }

        .office-title {
            background: white;
            color: #333;

            text-align: center;
            font-size: 29px;
            font-weight: normal;

            height: 39px;
            line-height: 39px;

            margin: 0 0 24px 0;
        }

        .office-table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            text-align: center;
        }

        .office-table th {
            background-color: #cfe2ff;
            color: black;
            font-weight: bold;
            font-size: 17px;
            padding: 10px 8px;
            border: 1px solid #b8c9dd;
        }

        .office-table td {
            font-size: 15px;
            padding: 10px 8px;
            height: 41px;
            border: 1px solid #dddddd;
        }

        .office-table tbody tr:nth-child(odd) {
            background-color: #f1f1f1;
        }

        .office-table tbody tr:nth-child(even) {
            background-color: white;
        }

        

        .contact-box {
            width: 332px;
            flex-shrink: 0;

            background-color: white;
            padding: 16px;

            border-radius: 5px;

            box-shadow: 0 3px 12px rgba(0,0,0,0.15);
        }

        .contact-title {
            text-align: center;
            font-size: 29px;
            font-weight: normal;
            color: #333;
            margin: 0 0 27px 0;
        }
/* FORM LABELS */

        .contact-box label {
            display: block;
            font-size: 14px;
            color: #333;
            margin-bottom: 9px;
        }

        

        .contact-box input,
        .contact-box textarea {
            width: 100%;
            border: 1px solid #dddddd;
            border-radius: 5px;
            padding: 9px 12px;
            font-family: Arial, sans-serif;
            font-size: 14px;
            margin-bottom: 18px;
        }

        .contact-box input {
            height: 39px;
        }

        .contact-box textarea {
            height: 110px;
            resize: vertical;
        }

        .contact-box input:focus,
        .contact-box textarea:focus {
            outline: none;
            border-color: #86b7fe;
            box-shadow: 0 0 0 3px rgba(13,110,253,0.15);
        }

        

        .send-button {
            width: 100%;
            height: 38px;

            background-color: #087ff5;
            color: white;

            border: none;
            border-radius: 5px;

            font-size: 14px;
            cursor: pointer;
        }

        .send-button:hover {
            background-color: #006bd6;
        }

        

        @media (max-width: 1050px) {

            .background {
                padding: 30px 20px;
            }

            .content {
                flex-wrap: wrap;
                justify-content: center;
            }

            .office-section {
                width: 100%;
                max-width: 641px;
            }

            .contact-box {
                width: 332px;
                max-width: 100%;
            }
        }

    </style>

</head>

<body>

    
    <nav class="navbar navbar-expand-lg navbar-dark">

        <div class="container-fluid">

            <!-- PUT LOGO LINK HERE -->

            <a class="navbar-brand" href="#">

                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTnKidy-_8jWmPpB6LBvevB2FVf548x2xP9_v3vVOqRewsjnvJYYMnCI8Y&s=10"
                    alt="School Logo"
                    class="school-logo"
                >

                Contact Us

            </a>

            

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#myNavbar">

                <span class="navbar-toggler-icon"></span>

            </button>

         

            <div class="collapse navbar-collapse" id="myNavbar">

                <form class="d-flex ms-auto" onsubmit="searchPage(event)">

                    <input
                        class="form-control me-2 search-box"
                        type="search"
                        id="searchInput"
                        placeholder="Search">

                    <button class="btn btn-primary search-button" type="submit">
                        Search
                    </button>

                </form>

            </div>

        </div>

    </nav>


   

    <main class="background">

        <div class="content">


            <section class="office-section" id="office">

                <h1 class="office-title">
                    School Office Hours
                </h1>

                <table class="office-table">

                    <thead>
                        <tr>
                            <th>Day</th>
                            <th>Office Hours</th>
                            <th>Department</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>
                            <td>Monday</td>
                            <td>8:00 AM – 4:00 PM</td>
                            <td>Registrar's Office</td>
                        </tr>

                        <tr>
                            <td>Tuesday</td>
                            <td>8:00 AM – 4:00 PM</td>
                            <td>Accounting Office</td>
                        </tr>

                        <tr>
                            <td>Wednesday</td>
                            <td>8:00 AM – 4:00 PM</td>
                            <td>Guidance Office</td>
                        </tr>

                        <tr>
                            <td>Thursday</td>
                            <td>8:00 AM – 4:00 PM</td>
                            <td>Principal's Office</td>
                        </tr>

                        <tr>
                            <td>Friday</td>
                            <td>8:00 AM – 3:00 PM</td>
                            <td>Admin Office</td>
                        </tr>

                    </tbody>

                </table>

            </section>


        

            <section class="contact-box" id="contact">

                <h2 class="contact-title">
                    Contact Us
                </h2>

                <form id="contactForm" onsubmit="sendMessage(event)">

                    <label for="fullName">Full Name</label>

                    <input
                        type="text"
                        id="fullName"
                        placeholder="Enter your full name"
                        required>


                    <label for="email">Email Address</label>

                    <input
                        type="email"
                        id="email"
                        placeholder="Enter your email"
                        required>


                    <label for="subject">Subject</label>

                    <input
                        type="text"
                        id="subject"
                        placeholder="Enter subject"
                        required>


                    <label for="message">Message</label>

                    <textarea
                        id="message"
                        placeholder="Type your message here"
                        required></textarea>


                    <button type="submit" class="send-button">
                        Send Message
                    </button>

                </form>

            </section>

        </div>

    </main>


    
    <script>

    

        function searchPage(event) {

            event.preventDefault();

            var searchText = document.getElementById("searchInput").value.trim();

            if (searchText === "") {
                alert("Please type something to search.");
                return;
            }

            var content = document.querySelector(".content").innerText.toLowerCase();

            if (content.includes(searchText.toLowerCase())) {
                alert("Found: " + searchText);
            } else {
                alert("No results found for: " + searchText);
            }

        }


  

        function sendMessage(event) {

            event.preventDefault();

            var name = document.getElementById("fullName").value;

            alert("Thank you, " + name + "! Your message has been submitted.");

            document.getElementById("contactForm").reset();

        }

    </script>


  

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>